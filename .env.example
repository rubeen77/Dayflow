# Server only. Copy to .env.local for local development; never use VITE_ prefixes.
# Exact public origin, with no path or trailing slash. Use a separate OAuth project for production.
APP_ORIGIN=http://localhost:4173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate 32 random bytes as 64 hex characters. Keep this key outside Redis.
GOOGLE_TOKEN_ENCRYPTION_KEY=
# Private durable Redis, preferably provisioned from the Vercel Marketplace.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional: enables the protected background read endpoint, never automatic Google writes.
CRON_SECRET=
